# ===== 知膳 NutriMind · 服务端配置 =====
# 所有变量都只在服务端读取，不会被打包进前端产物。
# 不配置 AI_* 时，核心文字餐食分析使用内置本地规则引擎；账号认证和在线大模型功能仍需要网络与服务端。

# 服务监听端口（部署平台通常要求 8000）
PORT=8000

# 账号数据存放目录（users.json 会写入这里）
DATA_DIR=./data

# 登录令牌签名密钥，正式部署务必替换为随机长字符串
AUTH_SECRET=please-change-this-to-a-long-random-string

# 魔搭 ModelScope 推理服务使用 OpenAI 兼容协议（不要带 /chat/completions）
AI_BASE_URL=https://api-inference.modelscope.cn/v1

# 魔搭访问令牌：https://modelscope.cn/my/myaccesstoken 创建，形如 ms-xxxx
# 只保存在服务端，前端通过 /api/ai/chat 代理调用
AI_API_KEY=ms-your-access-token

# 文本模型名称，需支持 chat/completions；可在魔搭「模型库」查看可用模型 ID，例如：
# Qwen/Qwen3.8-Flash-Next、Qwen/Qwen3.8-27B、deepseek-ai/DeepSeek-V4.1-Flash
# 当前产品仅支持中文文字记录与食物库补录，不支持图片上传、拍照或图像识别。
# 仅更换多模态模型不会增加图片能力，还需另行实现上传、多模态消息与服务端文件校验。
AI_MODEL=Qwen/Qwen3.8-Flash-Next

# 如果部署环境无法设置环境变量，也可以在项目根目录放 ai-config.json（已被 .gitignore 忽略）：
# { "baseUrl": "https://api-inference.modelscope.cn/v1", "apiKey": "ms-xxx", "model": "Qwen/Qwen3.8-Flash-Next" }
# 环境变量优先级高于该文件；也可用 AI_CONFIG_FILE 指定配置文件路径。
