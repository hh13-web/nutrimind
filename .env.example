# ===== 知膳 NutriMind · 服务端配置 =====
# 所有变量都只在服务端读取，不会被打包进前端产物。
# 不配置 AI_* 时，应用自动使用内置的本地营养解析引擎，全部功能可离线演示。

# 服务监听端口（部署平台通常要求 8000）
PORT=8000

# 账号数据存放目录（users.json 会写入这里）
DATA_DIR=./data

# 登录令牌签名密钥，正式部署务必替换为随机长字符串
AUTH_SECRET=please-change-this-to-a-long-random-string

# OpenAI 兼容接口的 Base URL（不要带 /chat/completions）
AI_BASE_URL=https://api.deepseek.com/v1

# 接口密钥（只保存在服务端，前端通过 /api/ai/chat 代理调用）
AI_API_KEY=sk-your-api-key-here

# 模型名称（需支持 chat/completions；图片识别需多模态模型，如 gpt-4o-mini / qwen-vl-plus）
AI_MODEL=deepseek-chat

# 如果部署环境无法设置环境变量，也可以在项目根目录放 ai-config.json（已被 .gitignore 忽略）：
# { "baseUrl": "https://api.deepseek.com/v1", "apiKey": "sk-xxx", "model": "deepseek-chat" }
# 环境变量优先级高于该文件；也可用 AI_CONFIG_FILE 指定配置文件路径。
