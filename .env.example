# ===== 知膳 NutriMind · AI 引擎配置（可选） =====
# 不配置任何变量时，应用会自动使用内置的本地营养解析引擎，全部功能可离线演示。
# 配置后，AI 餐食分析与 AI 营养师对话会调用 OpenAI 兼容接口（支持 DeepSeek / 通义千问 / Moonshot / OpenAI 等）。

# OpenAI 兼容接口的基础地址（不要带 /chat/completions）
VITE_AI_BASE_URL=https://api.deepseek.com/v1

# 接口密钥（仅用于本地演示，前端直连接口会暴露 Key，正式部署请通过服务端代理）
VITE_AI_API_KEY=sk-your-api-key-here

# 模型名称（需支持 chat/completions；图片识别需多模态模型，如 gpt-4o-mini / qwen-vl-plus）
VITE_AI_MODEL=deepseek-chat
